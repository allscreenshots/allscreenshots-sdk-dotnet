@using AllScreenshots.Sdk
@using AllScreenshots.Sdk.Models
@using AllScreenshots.Sdk.Exceptions
@inject AllScreenshotsClient Client

<div class="app">
    <header>
        <h1>Allscreenshots Demo</h1>
    </header>

    <main>
        <div class="form-section">
            <div class="input-row">
                <input type="text"
                       @bind="url"
                       @bind:event="oninput"
                       placeholder="https://github.com"
                       disabled="@isLoading" />
                <button @onclick="TakeScreenshot" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Capturing...</span>
                    }
                    else
                    {
                        <span>Take Screenshot</span>
                    }
                </button>
            </div>

            <div class="options-row">
                <div class="select-group">
                    <label>Device</label>
                    <select @bind="device" disabled="@isLoading">
                        <option value="Desktop HD">Desktop HD</option>
                        <option value="iPhone 14">iPhone 14</option>
                        <option value="iPad">iPad</option>
                    </select>
                </div>

                <div class="checkbox-group">
                    <label>
                        <input type="checkbox" @bind="fullPage" disabled="@isLoading" />
                        Full page
                    </label>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">
                @errorMessage
            </div>
        }

        <div class="result-section">
            <h2>Result</h2>
            <div class="result-container">
                @if (isLoading)
                {
                    <div class="loading">
                        <div class="spinner"></div>
                        <p>Capturing screenshot...</p>
                    </div>
                }
                else if (screenshotData != null)
                {
                    <img src="data:image/png;base64,@screenshotData" alt="Screenshot" />
                }
                else
                {
                    <div class="placeholder">
                        <p>Enter a URL and click "Take Screenshot" to capture</p>
                    </div>
                }
            </div>
        </div>
    </main>
</div>

@code {
    private string url = "https://github.com";
    private string device = "Desktop HD";
    private bool fullPage = false;
    private bool isLoading = false;
    private string? screenshotData = null;
    private string? errorMessage = null;

    private async Task TakeScreenshot()
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            errorMessage = "Please enter a URL";
            return;
        }

        isLoading = true;
        errorMessage = null;
        screenshotData = null;

        try
        {
            var request = new ScreenshotRequest
            {
                Url = url,
                Device = device,
                FullPage = fullPage
            };

            var imageBytes = await Client.Screenshots.CaptureAsync(request);
            screenshotData = Convert.ToBase64String(imageBytes);
        }
        catch (ValidationException ex)
        {
            errorMessage = $"Validation error: {string.Join(", ", ex.Errors.Select(e => $"{e.Field}: {e.Message}"))}";
        }
        catch (AuthenticationException)
        {
            errorMessage = "Authentication failed. Please check your API key.";
        }
        catch (RateLimitException ex)
        {
            errorMessage = $"Rate limit exceeded. Please try again after {ex.RetryAfter?.ToString("HH:mm:ss") ?? "a moment"}.";
        }
        catch (QuotaExceededException)
        {
            errorMessage = "Quota exceeded. Please upgrade your plan.";
        }
        catch (AllScreenshotsException ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
